# fleet.env — Environment config for fleet scripts
# Sourced by all scripts/fleet/*.sh
# Edit this file when paths or IDs change — scripts never hardcode these values.

# ── Repos & workspaces ────────────────────────────────────────────────────────
DEV_REPO="${DEV_REPO:-/Users/openclaw/workspace/openclaw-staging}"
STAGING_DIR="${STAGING_DIR:-$HOME/workspace/openclaw-staging}"
STAGING_REPO="${STAGING_REPO:-$HOME/workspace/openclaw-staging}"   # alias for releasectl staging commands
TEST_REPO="${TEST_REPO:-/Users/openclaw/workspace/openclaw-test}"
RELEASE_DIR="${RELEASE_DIR:-$HOME/workspace/openclaw-release}"
# Optional protected release-user ownership model:
# RELEASE_USER="oc-release"
# RELEASE_DIR="/Users/oc-release/workspace/openclaw-release"

# ── Fork ──────────────────────────────────────────────────────────────────────
FORK="xushen-ma/openclaw"
FORK_REMOTE="origin"
MAIN_BRANCH="main"                # branch on fork that agents PR into
PROD_BRANCH="production"   # branch on fork that release workspace tracks
# Optional deploy version base override (plain upstream tag only, e.g. v2026.3.7).
# Leave unset for auto-detection from first-parent git history.
RELEASE_BASE_VERSION="${RELEASE_BASE_VERSION:-}"

# ── Test instance ─────────────────────────────────────────────────────────────
TEST_ENV="$STAGING_DIR/.test-instance/test.env"
TEST_CONFIG="$STAGING_DIR/.test-instance/openclaw.test.json"

# ── Local config / token-safe verification ───────────────────────────────────
OPENCLAW_CONFIG_PATH="${OPENCLAW_CONFIG_PATH:-$HOME/.openclaw/openclaw.json}"
AIRI_TOKEN_JQ='.plugins.entries.airi.config.token // empty'
AIRI_BASE_URL="http://127.0.0.1:18789"

# ── Smoke test (Discord Tester Bot) ───────────────────────────────────────────
SMOKE_CHANNEL="1478703264584433806"     # #test-channel in test Discord server
SMOKE_BOT_MENTION="@Tester Bot"
SMOKE_RESPONSE_WAIT=20                  # seconds to wait for bot reply

# ── Our known patches (for integrity check) ───────────────────────────────────
# Grep patterns used by sanity-check.sh to verify our commits are present on main
PATCH_SMART_RESET_PATTERN="smart.reset\|smart reset"
PATCH_FAST_RESTART_PATTERN="fast.*launchd\|--fast.*restart\|launchd.*fast\|daemon.*fast"
PATCH_MATRIX_HEAL_PATTERN="self.heal\|matrix.*sdk\|sdk.*self"

# ── Coordination / locks ─────────────────────────────────────────────────────
FLEET_LOCK_DIR="${TMPDIR:-/tmp}/openclaw-fleet-locks"
STAGING_LOCK_FILE="$FLEET_LOCK_DIR/staging.lock"
TEST_LOCK_FILE="$FLEET_LOCK_DIR/test.lock"
RELEASE_LOCK_FILE="$FLEET_LOCK_DIR/release.lock"
SANITY_STATE_FILE="$FLEET_LOCK_DIR/last-sanity.env"
TEST_STATE_FILE="$FLEET_LOCK_DIR/last-test-deploy.env"
