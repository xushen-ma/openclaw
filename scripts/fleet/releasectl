#!/usr/bin/env bash
set -euo pipefail

SELF_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
SELF_DIR="$(dirname "$SELF_PATH")"

# Resolve runtime layout for both:
# - source tree: <repo>/scripts/fleet/releasectl
# - installed bundle: /usr/local/lib/openclaw-fleet/releasectl
if [[ -d "$SELF_DIR/internal" ]]; then
  SCRIPT_DIR="$SELF_DIR"
  if [[ "$SELF_DIR" == */scripts/fleet ]]; then
    ROOT_DIR="${RELEASECTL_ROOT_DIR:-$(cd "$SELF_DIR/../.." && pwd)}"
  else
    ROOT_DIR="${RELEASECTL_ROOT_DIR:-$(cd "$SELF_DIR/.." && pwd)}"
  fi
else
  ROOT_DIR="${RELEASECTL_ROOT_DIR:-$(cd "$SELF_DIR/../.." && pwd)}"
  SCRIPT_DIR="$ROOT_DIR/scripts/fleet"
fi

INTERNAL_DIR="${RELEASECTL_INTERNAL_DIR:-$SCRIPT_DIR/internal}"

# shellcheck disable=SC1091
source "$INTERNAL_DIR/permissions.sh"
source "$INTERNAL_DIR/fleet.env"

DEFAULT_CONFIG="${RELEASECTL_CONFIG:-$HOME/.openclaw/releasectl/config.env}"

load_releasectl_config() {
  local cfg="$DEFAULT_CONFIG"
  local env_release_user="${RELEASE_USER-}"
  local env_allow_sudo="${RELEASECTL_ALLOW_SUDO-}"
  local env_exec_path="${RELEASECTL_EXEC_PATH-}"
  local env_sudo_password="${RELEASECTL_SUDO_PASSWORD-}"
  local env_sudo_password_file="${RELEASECTL_SUDO_PASSWORD_FILE-}"

  [[ -f "$cfg" ]] && source "$cfg"

  [[ -n "$env_release_user" ]] && RELEASE_USER="$env_release_user"
  [[ -n "$env_allow_sudo" ]] && RELEASECTL_ALLOW_SUDO="$env_allow_sudo"
  [[ -n "$env_exec_path" ]] && RELEASECTL_EXEC_PATH="$env_exec_path"
  [[ -n "$env_sudo_password" ]] && RELEASECTL_SUDO_PASSWORD="$env_sudo_password"
  [[ -n "$env_sudo_password_file" ]] && RELEASECTL_SUDO_PASSWORD_FILE="$env_sudo_password_file"

  RELEASE_USER="${RELEASE_USER:-oc-release}"
  RELEASECTL_ALLOW_SUDO="${RELEASECTL_ALLOW_SUDO:-1}"
  RELEASECTL_EXEC_PATH="${RELEASECTL_EXEC_PATH:-/usr/local/lib/openclaw-fleet/releasectl}"
  RELEASECTL_SUDO_PASSWORD_FILE="${RELEASECTL_SUDO_PASSWORD_FILE:-$HOME/.openclaw/releasectl/sudo-password}"
}

is_governed_write_action() {
  case "${1:-}" in
    test-deploy|staging-deploy|test-release|promote-production|sanity-check|deploy|rollback|bundle-sync|repair-perms)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

resolve_user_home() {
  local user="$1"
  local home=""
  home="$(dscl . -read "/Users/$user" NFSHomeDirectory 2>/dev/null | awk '{print $2}' || true)"
  if [[ -z "$home" ]]; then
    home="$(python3 - "$user" <<'PY'
import pwd, sys
try:
  print(pwd.getpwnam(sys.argv[1]).pw_dir)
except KeyError:
  pass
PY
)"
  fi
  printf '%s\n' "$home"
}

resolve_sudo_password() {
  if [[ -n "${RELEASECTL_SUDO_PASSWORD:-}" ]]; then
    printf '%s' "$RELEASECTL_SUDO_PASSWORD"
    return 0
  fi

  if [[ -f "${RELEASECTL_SUDO_PASSWORD_FILE:-}" ]]; then
    head -n 1 "$RELEASECTL_SUDO_PASSWORD_FILE"
    return 0
  fi

  return 1
}

run_governed_sudo() {
  if [[ $# -eq 0 ]]; then
    echo "error: internal handoff bug: missing governed command" >&2
    exit 1
  fi

  local err_file
  err_file="$(mktemp)"
  if sudo -n -u "$RELEASE_USER" "$@" 2>"$err_file"; then
    rm -f "$err_file"
    exit 0
  fi

  local rc="$?"
  local sudo_err
  sudo_err="$(cat "$err_file")"
  rm -f "$err_file"

  if [[ "$sudo_err" != *"a password is required"* ]] \
     && [[ "$sudo_err" != *"no tty present"* ]] \
     && [[ "$sudo_err" != *"a terminal is required"* ]]; then
    [[ -n "$sudo_err" ]] && echo "$sudo_err" >&2
    exit "$rc"
  fi

  local sudo_pw=""
  sudo_pw="$(resolve_sudo_password 2>/dev/null || true)"
  if [[ -z "$sudo_pw" ]]; then
    echo "error: governed handoff requires sudo access to $RELEASE_USER" >&2
    echo "hint: configure sudoers NOPASSWD for releasectl handoff; front-door fallback also supports RELEASECTL_SUDO_PASSWORD / RELEASECTL_SUDO_PASSWORD_FILE" >&2
    exit 1
  fi

  printf '%s\n' "$sudo_pw" | sudo -S -p '' -u "$RELEASE_USER" "$@"
  exit $?
}

ensure_governed_handoff() {
  local action="$1"
  shift || true

  is_governed_write_action "$action" || return 0
  [[ "${RELEASECTL_SKIP_SUDO_HANDOFF:-0}" == "1" ]] && return 0

  local current_user
  current_user="$(id -un 2>/dev/null || true)"
  [[ -n "$current_user" ]] || return 0
  [[ "$current_user" == "$RELEASE_USER" ]] && return 0

  [[ "${RELEASECTL_ALLOW_SUDO:-1}" == "1" ]] || {
    echo "error: governed action '$action' requires $RELEASE_USER (sudo handoff disabled)" >&2
    exit 1
  }

  command -v sudo >/dev/null 2>&1 || {
    echo "error: sudo not found; cannot hand off to governed user $RELEASE_USER" >&2
    exit 1
  }

  local releasectl_exec="$RELEASECTL_EXEC_PATH"
  if [[ ! -x "$releasectl_exec" ]]; then
    releasectl_exec="$0"
  fi

  local release_home
  release_home="$(resolve_user_home "$RELEASE_USER")"
  [[ -n "$release_home" ]] || {
    echo "error: unable to resolve home for governed user $RELEASE_USER" >&2
    exit 1
  }

  if [[ "${RELEASECTL_CAPTURE_HANDOFF:-0}" == "1" ]]; then
    local capture_extra=""
    if [[ "$action" == "bundle-sync" ]]; then
      capture_extra=" source_root=$SCRIPT_DIR"
    fi
    echo "HANDOFF action=$action current_user=$current_user release_user=$RELEASE_USER exec=$releasectl_exec home=$release_home args=$*${capture_extra}"
    exit 0
  fi

  cd / || true

  if [[ "$action" == "bundle-sync" ]]; then
    # bundle-sync now means: import approved source-of-truth (default origin/main)
    # into the controlled repo, then sync the installed bundle from that controlled
    # repo so the local governed bundle materializes approved remote main.
    local controlled_repo
    controlled_repo="$(grep "^RELEASECTL_CONTROLLED_REPO=" "$SELF_DIR/internal/fleet.env" 2>/dev/null | cut -d= -f2 | tr -d '"'"'"'"'"')" || true
    controlled_repo="${controlled_repo:-/Users/openclaw/workspace/openclaw-fleet-mgmt}"
    run_governed_sudo env RELEASECTL_SOURCE_ROOT="$controlled_repo" RELEASECTL_BUNDLE_SYNC_IMPORT_REF="${RELEASECTL_BUNDLE_SYNC_IMPORT_REF:-origin/main}" "$releasectl_exec" "$action" "$@"
  fi

  run_governed_sudo "$releasectl_exec" "$action" "$@"
}

usage() {
  cat <<'EOF'
releasectl - governed release helper

Usage:
  releasectl repair-perms [--repo <path>] [--dry-run]
  releasectl test-deploy --sha <branch|sha|ref>
  releasectl test-status
  releasectl test-release [--force]
  releasectl staging-deploy --sha <branch|sha|ref>
  releasectl promote-production --sha <branch|sha|ref> [--allow-untagged]
  releasectl sanity-check [--sha <sha>] [--skip-smoke]
  releasectl deploy [args...]
  releasectl rollback [args...]
  releasectl bundle-sync [--check|--sync]
  releasectl verify-config

Commands:
  repair-perms    Normalize file/dir permissions for governed repos.

  test-deploy     Deploy branch/SHA/ref to governed staging test lane.
                  Alias: staging-deploy
  test-status     Show staging/test lane lock status.
  test-release    Release stale staging/test lane lock (safety-gated).

  staging-deploy  Alias of test-deploy for backward compatibility.
  promote-production
                  Merge validated candidate onto production lineage and print
                  resulting production commit SHA.
  sanity-check    Run governed pre-deploy sanity validation (optional --sha pin,
                  optional --skip-smoke).
  deploy          Run internal production deploy flow, then normalize permissions.
  rollback        Run internal rollback flow, then normalize permissions.
  bundle-sync     Check/sync installed governed bundle; on --sync, first import approved source repo ref (default origin/main) into the controlled repo, then sync installed files.
  verify-config   Print effective governed paths and detect legacy config drift.

Notes:
  - Keeps write authority with oc-release workflow; this command only repairs
    read/execute visibility drift (e.g., 0600/0700 leftovers).
  - No ownership changes are performed.
EOF
}

repo_root="$ROOT_DIR"
dry_run=0

parse_common_flags() {
  while (($#)); do
    case "$1" in
      --repo)
        repo_root="$2"
        shift 2
        ;;
      --dry-run)
        dry_run=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "error: unknown flag: $1" >&2
        exit 2
        ;;
    esac
  done
}

run_with_post_normalize() {
  local internal_script="$1"
  shift
  local script_path="$INTERNAL_DIR/$internal_script"
  if [[ ! -x "$script_path" ]]; then
    echo "error: missing internal command: $script_path" >&2
    return 1
  fi

  "$script_path" "$@"
  normalize_repo_permissions "$repo_root" "apply"
}

require_sha_flag() {
  local subcommand="$1"
  shift
  local value=""
  while (($#)); do
    case "$1" in
      --sha)
        value="${2:-}"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "error: unknown flag for $subcommand: $1" >&2
        exit 2
        ;;
    esac
  done

  if [[ -z "$value" ]]; then
    echo "error: missing required flag --sha <branch|sha|ref>" >&2
    exit 2
  fi

  printf '%s\n' "$value"
}

show_lock_status() {
  local lock_file="$1"
  if [[ ! -f "$lock_file" ]]; then
    echo "test lane status: available"
    echo "lock_file=$lock_file"
    return 0
  fi

  local owner agent session purpose target_sha pid started host pwd
  owner=$(grep '^OWNER=' "$lock_file" 2>/dev/null | cut -d= -f2- || true)
  agent=$(grep '^AGENT=' "$lock_file" 2>/dev/null | cut -d= -f2- || true)
  session=$(grep '^SESSION=' "$lock_file" 2>/dev/null | cut -d= -f2- || true)
  purpose=$(grep '^PURPOSE=' "$lock_file" 2>/dev/null | cut -d= -f2- || true)
  target_sha=$(grep '^TARGET_SHA=' "$lock_file" 2>/dev/null | cut -d= -f2- || true)
  pid=$(grep '^PID=' "$lock_file" 2>/dev/null | cut -d= -f2- || true)
  started=$(grep '^STARTED_AT=' "$lock_file" 2>/dev/null | cut -d= -f2- || true)
  host=$(grep '^HOST=' "$lock_file" 2>/dev/null | cut -d= -f2- || true)
  pwd=$(grep '^PWD=' "$lock_file" 2>/dev/null | cut -d= -f2- || true)

  echo "test lane status: busy"
  echo "lock_file=$lock_file"
  echo "owner=${owner:-unknown}"
  echo "agent=${agent:-unknown}"
  echo "session=${session:-unknown}"
  echo "purpose=${purpose:-unknown}"
  echo "target_sha=${target_sha:-unknown}"
  echo "pid=${pid:-unknown}"
  echo "started_at=${started:-unknown}"
  echo "host=${host:-unknown}"
  echo "pwd=${pwd:-unknown}"

  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    echo "pid_state=running"
  else
    echo "pid_state=stale"
  fi
}

verify_config() {
  local cfg="$DEFAULT_CONFIG"
  local legacy_test_repo="${TEST_REPO-}"

  echo "config_file=$cfg"
  echo "release_user=$RELEASE_USER"
  echo "release_exec=${RELEASECTL_EXEC_PATH:-unset}"
  echo "staging_repo=${STAGING_REPO:-unset}"
  echo "staging_dir=${STAGING_DIR:-unset}"
  echo "dev_repo=${DEV_REPO:-unset}"

  if [[ -n "$legacy_test_repo" ]]; then
    echo "legacy_test_repo=$legacy_test_repo"
    if [[ "$legacy_test_repo" == *"/openclaw-test" ]]; then
      echo "config_drift=legacy TEST_REPO points at openclaw-test (ignored by current releasectl, but stale runtime/config exists)"
      return 1
    fi
  fi

  if [[ "${STAGING_REPO:-}" == *"/openclaw-test" || "${STAGING_DIR:-}" == *"/openclaw-test" ]]; then
    echo "config_drift=staging path still points at openclaw-test"
    return 1
  fi

  echo "config_drift=none"
}

command="${1:-}" || true
if [[ -z "$command" ]]; then
  usage
  exit 2
fi
shift || true

load_releasectl_config
ensure_governed_handoff "$command" "$@"

case "$command" in
  repair-perms)
    parse_common_flags "$@"
    if [[ "$dry_run" -eq 1 ]]; then
      normalize_repo_permissions "$repo_root" "dry-run"
    else
      normalize_repo_permissions "$repo_root" "apply"
    fi
    ;;
  test-deploy)
    target_ref="$(require_sha_flag "test-deploy" "$@")"
    run_with_post_normalize "test-deploy.sh" "${TEST_REPO:-${TEST_DIR:-$HOME/workspace/openclaw-test}}" "$target_ref"
    ;;
  staging-deploy)
    target_ref="$(require_sha_flag "staging-deploy" "$@")"
    "$INTERNAL_DIR/staging-deploy.sh" "$target_ref"
    normalize_repo_permissions "${STAGING_REPO:-${STAGING_DIR:-$HOME/workspace/openclaw-staging}}" "apply"
    ;;
  test-status)
    # shellcheck disable=SC1091
    source "$INTERNAL_DIR/fleet.env"
    test_lock_file="${TEST_LOCK_FILE:-${TEST_REPO:-$HOME/workspace/openclaw-test}/.test-env.lock}"
    show_lock_status "$test_lock_file"
    ;;
  test-release)
    force=0
    while (($#)); do
      case "$1" in
        --force) force=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "error: unknown flag for test-release: $1" >&2; exit 2 ;;
      esac
    done
    # shellcheck disable=SC1091
    source "$INTERNAL_DIR/fleet.env"
    test_lock_file="${TEST_LOCK_FILE:-${TEST_REPO:-$HOME/workspace/openclaw-test}/.test-env.lock}"
    if [[ ! -f "$test_lock_file" ]]; then
      echo "test lane already available"
      exit 0
    fi

    lock_pid="$(grep '^PID=' "$test_lock_file" 2>/dev/null | cut -d= -f2- || true)"
    if [[ "$force" -ne 1 ]] && [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
      echo "error: lock is currently held by active pid=$lock_pid; refusing to release without --force" >&2
      exit 1
    fi

    rm -f "$test_lock_file"
    echo "released test lane lock: $test_lock_file"
    ;;
  promote-production)
    "$INTERNAL_DIR/promote-production.sh" "$@"
    ;;
  sanity-check)
    # Parse --sha flag and translate to FLEET_TARGET_SHA env var for sanity-check.sh
    _sanity_sha=""
    _sanity_args=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --sha) _sanity_sha="${2:?--sha requires a value}"; shift 2 ;;
        *) _sanity_args+=("$1"); shift ;;
      esac
    done
    if [[ -n "$_sanity_sha" ]]; then
      FLEET_TARGET_SHA="$_sanity_sha" "$INTERNAL_DIR/sanity-check.sh" "${_sanity_args[@]+"${_sanity_args[@]}"}"
    else
      "$INTERNAL_DIR/sanity-check.sh" "${_sanity_args[@]+"${_sanity_args[@]}"}"
    fi
    ;;
  deploy)
    # Parse --sha flag and translate to FLEET_TARGET_SHA env var for deploy.sh
    _deploy_sha=""
    _deploy_args=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --sha) _deploy_sha="${2:?--sha requires a value}"; shift 2 ;;
        *) _deploy_args+=("$1"); shift ;;
      esac
    done
    if [[ -n "$_deploy_sha" ]]; then
      FLEET_TARGET_SHA="$_deploy_sha" run_with_post_normalize "deploy.sh" "${_deploy_args[@]+"${_deploy_args[@]}"}"
    else
      run_with_post_normalize "deploy.sh" "${_deploy_args[@]+"${_deploy_args[@]}"}"
    fi
    ;;
  rollback)
    run_with_post_normalize "rollback.sh" "$@"
    ;;
  bundle-sync)
    mode="--check"
    while (($#)); do
      case "$1" in
        --check|--sync)
          mode="$1"
          shift
          ;;
        -h|--help)
          usage
          exit 0
          ;;
        *)
          echo "error: unknown flag for bundle-sync: $1" >&2
          exit 2
          ;;
      esac
    done
    "$INTERNAL_DIR/sync-installed-bundle.sh" "$mode"
    ;;
  verify-config)
    verify_config
    ;;
  -h|--help)
    usage
    ;;
  *)
    echo "error: unknown command: $command" >&2
    usage
    exit 2
    ;;
esac
